{
  "name": "dsh-wdc-computer-use",
  "version": "2.2.0",
  "displayName": "ComputerUse-DSH",
  "description": "ComputerUse-DSH：为 DeepSeek Harness 提供 Windows 截图、鼠标、键盘和窗口操作。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --test ../test_support/client-policy.test.mjs ../test_support/plugin.test.mjs ../test_support/visual-feedback.test.mjs ../test_support/visual-preview.test.mjs ../test_support/feedback-session.test.mjs ../test_support/native-feedback-host.test.mjs",
    "preview:build": "node ../scripts/build-visual-preview.mjs",
    "client:build": "node ../scripts/build-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "mcp",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wjszjm/ComputerUse-DSH.git",
    "directory": "dsh-wdc-computer-use"
  },
  "bugs": {
    "url": "https://github.com/wjszjm/ComputerUse-DSH/issues"
  },
  "homepage": "https://github.com/wjszjm/ComputerUse-DSH#readme",
  "engines": {
    "node": ">=22.19.0"
  }
}
